VITE_XYZ_MOCK_MODE=false
VITE_XYZ_WIDGET=false
VITE_XYZ_ENVIRONMENT_URL=http://localhost

# Used by both the Vite dev proxy and the production Express server
# (server-side only, NOT exposed to the browser).
BACKEND_URL=http://localhost:5000
OAUTH_TOKEN_URL=https://XYZ.Org.com/oauth2/token
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_AUDIENCE=your-audience
OAUTH_SCOPE=read write
