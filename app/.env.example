# Server-side only — copy to .env and fill in your key (never commit .env).
GEMINI_API_KEY=your-gemini-api-key-here

# Default: gemini-3.6-flash (free tier on https://ai.google.dev/gemini-api/docs/pricing).
# Do NOT use gemini-2.0-flash — it was shut down 2026-06-01 per Google's model page.
# Budget alternative: gemini-3.5-flash-lite (also free tier; lighter/cheaper, lower quality).
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_PDF_MODEL=gemini-2.5-flash

# Optional — only if you use a separate backend via the XYZ proxy pattern
# BACKEND_URL=http://localhost:5000
