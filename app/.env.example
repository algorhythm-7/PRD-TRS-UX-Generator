# Server-side only — copy to .env and fill in your key (never commit .env).
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_PDF_MODEL=gemini-2.0-flash

# Optional — only if you use a separate backend via the XYZ proxy pattern
# BACKEND_URL=http://localhost:5000
# OAUTH_TOKEN_URL=https://XYZ.Org.com/oauth2/token
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_AUDIENCE=your-audience
# OAUTH_SCOPE=read write
